{
  "name": "openisd-mcp",
  "version": "0.1.0",
  "description": "MCP server for the OpenISD Thiele-Small loudspeaker physics engine",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openisd-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "vendor/dist",
    "vendor/drivers",
    "vendor/fixtures",
    "OPENISD_SHA",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "bash scripts/vendor.sh",
    "build": "tsc",
    "prepare": "npm run vendor && npm run build",
    "prepublishOnly": "npm run vendor && npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OddieDank/openisd-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openisd",
    "thiele-small",
    "loudspeaker",
    "speaker-design",
    "audio-engineering"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}